{{template "head" .}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Flockdeck",
  "description": "A desktop app that runs Claude Code, Codex, Gemini and other coding agents on hardware you control, self-hosted or on your desk, and reaches your phone or laptop with no port opened.",
  "url": {{ .URL }},
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Windows, macOS, Linux",
  "license": "https://opensource.org/licenses/MIT",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
}
</script>
</head>
<body>

{{template "header" .}}

<main class="wrap" id="main">

<section class="hero">
  <p class="kicker"><span aria-hidden="true" class="dot waiting">▲</span> Built to keep working after you've gone</p>
  <h1>Start it on a box that never sleeps. <em>Steer it from wherever you are.</em></h1>
  <p class="lede">Flockdeck runs Claude Code, Codex, Gemini or your own model on
     hardware you already own — a spare machine, a NAS, a cheap VPS — and
     reaches your phone with no port opened and no password. Free and open
     source, self-hosted or not.</p>
  <p class="cta">
    <a class="button" href="#install">Install Flockdeck</a>
    <a class="button ghost" href="{{ .Repo }}">Source on GitHub</a>
  </p>
  <p class="cta-note">Free and open source · Windows, macOS and Linux</p>
  <ul class="works" aria-label="Works with">
    <li class="works-label" aria-hidden="true">Works with</li>
    <li>Claude Code</li>
    <li>Codex</li>
    <li>Gemini CLI</li>
    <li>Aider</li>
    <li>opencode</li>
    <li>Cursor Agent</li>
    <li>Ollama and any OpenAI-compatible API</li>
  </ul>
</section>

<!-- The hero is the application rather than a picture of it: the panes below
     run a scripted session, and the point of the whole thing — one agent going
     amber while the others carry on — happens in front of you. The markup is
     the finished state and the script plays each terminal's lines back out of
     it, so with scripting off, or motion turned down, the page still shows a
     deck with one pane waiting. data-at is how long each line waits after the
     one before it. -->
<section class="deck" id="deck" aria-label="A Flockdeck window with three agents running">
  <div class="deck-bar">
    <span class="deck-tab on"><span aria-hidden="true" class="dot working" data-tab="api">●</span> api</span>
    <span class="deck-tab"><span aria-hidden="true" class="dot waiting" data-tab="ui">▲</span> ui</span>
    <span class="deck-tab"><span aria-hidden="true" class="dot idle" data-tab="docs">●</span> docs</span>
    <span class="deck-tally">
      <span><span aria-hidden="true" class="dot waiting">▲</span> <b data-tally="waiting">1</b> waiting</span>
      <span><span aria-hidden="true" class="dot working">●</span> <b data-tally="working">1</b> working</span>
    </span>
  </div>
  <div class="deck-panes">
    <div class="pane" data-pane="api">
      <div class="pane-head"><span aria-hidden="true" class="dot working">●</span> <span class="name">api</span> <span class="branch">feat/api</span></div>
      <pre class="term" data-term="api" data-at="0 420 760 700 900"><span class="u">$</span> flockdeck — agent: claude-code
<b>Reading</b> internal/api/router.go
<b>Edit</b> internal/api/router.go <span class="dim">+38 −12</span>
<b>Running</b> go test ./internal/api/
<span class="ok">ok</span>  internal/api  <span class="dim">1.284s</span></pre>
    </div>
    <div class="pane is-waiting" data-pane="ui">
      <div class="pane-head"><span aria-hidden="true" class="dot waiting">▲</span> <span class="name">ui</span> <span class="branch">feat/ui</span></div>
      <pre class="term" data-term="ui" data-at="0 500 820 700 260 200"><span class="u">$</span> flockdeck — agent: codex
<b>Reading</b> internal/webui/assets/app.js
<b>Edit</b> internal/webui/assets/app.css <span class="dim">+21 −4</span>
<span class="warn">▲ Permission needed</span>
<span class="warn">Allow write to internal/webui/assets/?</span>
<span class="dim">waiting for you…</span></pre>
    </div>
    <div class="pane wide" data-pane="docs">
      <div class="pane-head"><span aria-hidden="true" class="dot idle">●</span> <span class="name">docs</span> <span class="branch">main</span></div>
      <pre class="term" data-term="docs" data-at="0 560 900 700"><span class="u">$</span> flockdeck — agent: gemini
<b>Reading</b> README.md
<b>Edit</b> README.md <span class="dim">+64 −9</span>
<span class="dim">finished its turn</span></pre>
    </div>
  </div>
</section>
<p class="deck-cap">Three agents on three branches. One needs you.</p>

<div class="legend" role="group" aria-label="What the status glyphs mean">
  <div><span aria-hidden="true" class="dot working">●</span> <b>working</b> <span class="t">agent is running</span></div>
  <div><span aria-hidden="true" class="dot waiting">▲</span> <b>waiting</b> <span class="t">needs your input</span></div>
  <div><span aria-hidden="true" class="dot idle">●</span> <b>idle</b> <span class="t">finished its turn</span></div>
  <div><span aria-hidden="true" class="dot exited">●</span> <b>exited</b> <span class="t">process has stopped</span></div>
</div>

<section class="band" id="why">
  <p class="eyebrow">The problem</p>
  <h2>One agent is easy. Five is chaos.</h2>
  <p>Agents finish at different times and stop for permission prompts. Before
     long you're flicking between terminals looking for the one that's stuck.
     Flockdeck shows you <strong>which agent needs you right now</strong>, and
     can give each one its own branch so they never trip over each other.</p>
</section>

<section class="band shot" id="app">
  <p class="eyebrow">In the app</p>
  <h2>Every agent in one window.</h2>
  <figure class="figure">
    <img src="{{asset "deck.png"}}" srcset="{{asset "deck-1584.png"}} 1584w, {{asset "deck.png"}} 3168w" sizes="(max-width: 1080px) 100vw, 1032px" width="1584" height="985" loading="lazy" alt="A Flockdeck window with four agents in a two-by-two grid, and a rail down the left listing four open projects, two of them badged amber because an agent in each is waiting. Gemini CLI has written a four-step plan, Claude Code is running tests on the pricing branch, Codex is adding a search endpoint, and a second Claude Code pane is highlighted in amber, waiting for permission to run a migration. The two Claude Code panes' headers show what they have spent: an estimated $2.14 for the one running tests, and 221k tokens for the waiting one, beside a small meter saying 72% of its five-hour limit is used.">
    <figcaption class="caption">Four agents on four branches. Amber marks the pane, and the project, waiting on you.</figcaption>
  </figure>
</section>

<section class="band" id="what">
  <p class="eyebrow">Features</p>
  <h2>Built for running agents in parallel.</h2>
  <div class="grid">
    <div class="card">
      <span class="g">self-hosted · remote</span>
      <h3>Runs on hardware you control</h3>
      <p>Free to run headless on a spare machine, a home server or a VPS —
         <code>-no-window</code> needs no browser there either — and pair it
         from your phone or laptop with a QR code. No port opened, no
         password.</p>
    </div>
    <div class="card">
      <span class="g">agents · models</span>
      <h3>Any agent, any model</h3>
      <p>Claude Code, Codex, Gemini, Aider, opencode and Cursor Agent. Or talk to
         a model API directly, including local Ollama and any OpenAI-compatible
         endpoint. Pick one per pane, and set a default for each project.</p>
    </div>
    <div class="card">
      <span class="g"><span aria-hidden="true">▲</span> waiting</span>
      <h3>Know who needs you</h3>
      <p>Every pane shows whether its agent is working, waiting or done. Tabs and
         projects light up too, and you get a desktop notification when an agent
         is waiting while you're working somewhere else.</p>
    </div>
    <div class="card">
      <span class="g">git worktrees</span>
      <h3>Worktrees built in</h3>
      <p>Create, switch and clean up git worktrees without leaving the app, so
         your agents work in parallel without touching each other's files.</p>
    </div>
    <div class="card">
      <span class="g">fan out</span>
      <h3>Turn a plan into a team</h3>
      <p>Flockdeck reads the task list an agent wrote, lets you edit it, then
         starts one agent per task, each on its own branch.</p>
    </div>
    <div class="card">
      <span class="g">routing</span>
      <h3>The right model for each task</h3>
      <p>Turn on routing for a project and fan out pre-sets tasks to a model
         that suits them: a smaller one to run the tests, a stronger one for a
         refactor. You see every choice before anything starts, and can change
         it.</p>
    </div>
    <div class="card">
      <span class="g">spend · limits</span>
      <h3>See what each agent spends</h3>
      <p>API agent panes estimate what each conversation has cost. Claude Code
         panes show what they've used and how close a subscription is to its
         five-hour and weekly limits, where you have a status line of your own
         or once you turn it on in Settings. It's all worked out on your
         machine.</p>
    </div>
    <div class="card">
      <span class="g">context</span>
      <h3>Agents that know the team</h3>
      <p>Claude Code and the built-in API client are told which pane they're in
         and what the others are working on, so they can coordinate instead of
         colliding.</p>
    </div>
    <div class="card">
      <span class="g">detach · reattach</span>
      <h3>Pick up where you left off</h3>
      <p>Your layout and open projects come back when you reopen Flockdeck, and
         so do conversations with agents that can resume them. Detach, and your agents keep running after the window
         closes. A past Claude Code conversation can be resumed in a new tab.</p>
    </div>
    <div class="card">
      <span class="g">review · commit · push</span>
      <h3>Review and ship</h3>
      <p>See every change an agent made, then commit and push it, without
         leaving the app.</p>
    </div>
    <div class="card">
      <span class="g">broadcast</span>
      <h3>Say it once</h3>
      <p>Write one prompt and send it to every agent in the tab, or to just the
         panes you pick.</p>
    </div>
    <div class="card">
      <span class="g">all agents</span>
      <h3>Every agent, every project</h3>
      <p>One list of every agent in every open project, each with its status,
         and a jump to any of them.</p>
    </div>
  </div>
</section>

<section class="band" id="fanout">
  <p class="eyebrow">Fan out</p>
  <h2>One plan in. A branch per task out.</h2>
  <p>Ask an agent for a plan and edit the list. Flockdeck starts an agent for
     every line, each in its own worktree, and your deck fills up. With
     routing on, lines that match a rule come with a smaller or a stronger
     model already chosen.</p>
  <div class="fan">
    <div class="fan-plan">
      <ol>
        <li>Extract the config loader</li>
        <li>Add the retry policy</li>
        <li>Document the wire format</li>
      </ol>
    </div>
    <div class="fan-arrow" aria-hidden="true">→</div>
    <div class="fan-out">
      <ul>
        <li><span aria-hidden="true" class="dot working">●</span> config-loader <span class="br">feat/config-loader</span></li>
        <li><span aria-hidden="true" class="dot working">●</span> retry-policy <span class="br">feat/retry-policy</span></li>
        <li><span aria-hidden="true" class="dot waiting">▲</span> wire-format <span class="br">docs/wire-format</span></li>
      </ul>
    </div>
  </div>
  <figure class="figure">
    <img src="{{asset "fanout.png"}}" srcset="{{asset "fanout-1584.png"}} 1584w, {{asset "fanout.png"}} 3168w" sizes="(max-width: 1080px) 100vw, 1032px" width="1584" height="985" loading="lazy" alt="The Fan out dialog listing four tasks read from an agent's plan, with the whole run on Claude Code's Sonnet and a model picker for each task. A line says routing chose a smaller model for one of the four tasks and a stronger one for another, beside a button to use the run's model for every task. Moving cart totals into a pricing package is set to Haiku and tagged routed, with an arrow pointing down; handling Stripe refund webhooks is set to Opus and tagged routed, with an arrow pointing up; the other two stay on the run's model. Below them are options to give each agent its own git worktree and to put them in this tab, and the Start button, beside 4 agents, 2 routed.">
    <figcaption class="caption">Fan out picks up the plan straight from the agent's output, and routing marks each task it moved to another model.</figcaption>
  </figure>
</section>

<!-- Remote access, as the design in flockdeck-relay settles it: dialling out,
     pairing, the same interface, and what the relay can see, then the two
     commands that turn it on. The relay's address is left out, since it is
     still free to change. -->
<section class="band" id="remote">
  <p class="eyebrow">Remote access</p>
  <h2>Check in on your agents from anywhere.</h2>
  <p>Leave Flockdeck running at your desk — or headless, on a server you
     own — and pick it up from your laptop, tablet or phone. See
     <strong>which agent is waiting</strong> and unblock it from wherever you
     are.</p>
  <div class="relay" role="group" aria-label="A paired device reaches the desktop through the Flockdeck relay, which the desktop connects out to">
    <div class="relay-node">
      <span class="g">phone · tablet · laptop</span>
      <div class="relay-tally"><span><span aria-hidden="true" class="dot waiting">▲</span> 1 waiting</span> <span><span aria-hidden="true" class="dot working">●</span> 2 working</span></div>
      <span class="t">any browser you've paired</span>
    </div>
    <div class="relay-link" aria-hidden="true"><span class="arrow">⟷</span><span class="t">TLS</span></div>
    <div class="relay-node hub">
      <span class="g">Flockdeck relay</span>
      <div class="relay-tally">secure connection</div>
      <span class="t">hosted for you</span>
    </div>
    <div class="relay-link" aria-hidden="true"><span class="arrow">⟵</span><span class="t">outbound · TLS</span></div>
    <div class="relay-node">
      <span class="g">your desktop</span>
      <div class="relay-tally"><span><span aria-hidden="true" class="dot working">●</span> api</span> <span><span aria-hidden="true" class="dot waiting">▲</span> ui</span> <span><span aria-hidden="true" class="dot idle">●</span> docs</span></div>
      <span class="t">your agents keep running here</span>
    </div>
  </div>
  <!-- A phone paired through the relay, answering the agent the deck shows
       waiting: what remote access is for, in one picture. It stands beside
       the cards, being tall and narrow, and under them on a small screen. -->
  <div class="remote-phone">
  <div class="grid">
    <div class="card">
      <span class="g">outbound only</span>
      <h3>No ports. No VPN.</h3>
      <p>Your desktop connects out to the relay, so there's nothing to open on
         your router and nothing exposed to the internet.</p>
    </div>
    <div class="card">
      <span class="g">link · QR code</span>
      <h3>Pair in seconds</h3>
      <p>Scan a QR code or open a one-time link from your desktop. There are no
         passwords to set, and you can revoke any device at any time.</p>
    </div>
    <div class="card">
      <span class="g">full app</span>
      <h3>The complete Flockdeck</h3>
      <p>Every pane, every status, the agent picker and fan out. Claude Code
         and Flockdeck's own chat client open as a conversation, not a raw
         terminal, and the full interface is one tap away. Attach a photo or
         several, straight from the camera, and long replies, code and diffs
         fold so you're not scrolling past them.</p>
    </div>
    <div class="card">
      <span class="g">private</span>
      <h3>Only your desktops</h3>
      <p>Your devices reach your desktops and nobody else's. Connections are
         encrypted with TLS over the internet. The relay decrypts traffic to
         route it, so remote access is not end-to-end encrypted. See
         <a href="trust.html">trust &amp; privacy</a> for what is, and what
         isn't, said plainly.</p>
    </div>
    <div class="card">
      <span class="g">no desk needed</span>
      <h3>Or run it on a server instead</h3>
      <p>Flockdeck doesn't need a desk at all: start it with
         <code>-no-window</code> on a spare machine, a home server or a VPS —
         no browser needed there either — and pair it the same way. Your
         agents run round the clock on hardware you control, free, in place
         of a paid coding-agents-in-the-cloud service.</p>
    </div>
  </div>
  <figure class="figure phone">
    <img src="{{asset "remote-choices.png"}}" srcset="{{asset "remote-choices-585.png"}} 585w, {{asset "remote-choices.png"}} 1170w" sizes="(max-width: 880px) 300px, 280px" width="390" height="844" loading="lazy" alt="Flockdeck's web client on a phone, open on the shopfront-payments pane, where Claude Code is waiting on you. Over the terminal it repeats the question, Do you want to proceed?, and the command asking to run, go run ./cmd/migrate up, then offers the three answers as big buttons to tap: Yes; Yes, and don't ask again for go run; and No, and tell Claude what to do, with Escape under them and the row of keys below. A banner above says billing-service is waiting on you too.">
    <figcaption class="caption">An agent's question, answered from your phone with a tap.</figcaption>
  </figure>
  </div>
  <p>Turn it on in <em>Settings › Remote access</em>, from the command palette,
     or from any terminal, then pair your phone:</p>
  <pre><code>flockdeck remote enable
flockdeck remote pair     <span class="c"># shows a QR code to scan</span></code></pre>
  <p class="aside">Remote access needs Flockdeck 0.2 or later and is off until you
     turn it on. Turn it off and your desktop is removed from the relay.</p>
  <!-- Announced, not shipped: it says what is coming, that it is for companies
       and under licence, and nothing about price or date, which are not
       settled. Nobody can run a relay today, individuals are not offered one,
       and the relay is not open source, so nothing here may suggest
       otherwise. Nor may anything here promise what the shared relay
       will cost, which is not settled either. The app's own Settings say the
       same beside it, which is where somebody using it will meet the plan.
       v0.2.9's Settings link #private-relays, so that id stays, on the card's
       first line, and lands on the whole card. -->
  <div class="pair plan">
    <div class="card soon" id="enterprise">
      <span class="g" id="private-relays">coming soon · for companies</span>
      <h3>Enterprise</h3>
      <p>For companies whose rules don't allow a third party to decrypt their
         developers' terminal traffic: run the relay on your own
         infrastructure, under licence, with SSO and support. The relay's
         own configuration already supports this today; see
         <a href="https://docs.flockdeck.ai/self-hosting/overview.html">self-hosting the relay</a>
         in the docs.</p>
    </div>
    <figure class="figure">
      <img src="{{asset "settings.png"}}" srcset="{{asset "settings-1584.png"}} 1584w, {{asset "settings.png"}} 3168w" sizes="(max-width: 880px) 100vw, 505px" width="1584" height="985" loading="lazy" alt="The Settings dialog open over a window of running agents, on its Account and plan section, with General, Terminal, Agents, API keys and Remote access listed beside it. Free is marked as the current plan, covering every part of the desktop app and remote access through the shared relay. Enterprise, for companies to run the relay on their own infrastructure with SSO and support, is marked coming soon, with a link to read about Enterprise. Under them, a line links the privacy policy, terms and licences.">
      <figcaption class="caption">Settings say which plan you're on, and what is coming.</figcaption>
    </figure>
  </div>
</section>
<section class="band shot">
  <p class="eyebrow">Built in</p>
  <h2>Pick any agent. See every branch.</h2>
  <div class="pair">
    <figure class="figure">
      <img src="{{asset "agent-picker.png"}}" srcset="{{asset "agent-picker-1584.png"}} 1584w, {{asset "agent-picker.png"}} 3168w" sizes="(max-width: 880px) 100vw, 505px" width="1584" height="985" loading="lazy" alt="The New agent tab picker open over a window of running agents. Claude Code, marked as this project's default, Codex and Gemini CLI are listed as installed, with five, five and four models; Aider, opencode, Cursor Agent and the API agents are listed below them, each with how to set it up, and the OpenAI-compatible endpoint offers to take its address there and then. At its foot, a box makes the choice the default, for this project or for every project, beside a button that gives up this project's own default for the one every project uses.">
      <figcaption class="caption">Pick an agent and model for each pane.</figcaption>
    </figure>
    <figure class="figure">
      <img src="{{asset "worktrees.png"}}" srcset="{{asset "worktrees-1584.png"}} 1584w, {{asset "worktrees.png"}} 3168w" sizes="(max-width: 880px) 100vw, 505px" width="1584" height="985" loading="lazy" alt="The Worktrees panel listing main and four other branches, each with its git status, the agents working in it, and buttons to open an agent, a shell, a split or a review there, or to remove it. One checkout's folder has been deleted, so it is marked folder gone and offers only Prune.">
      <figcaption class="caption">Every checkout, its branch and the agents in it.</figcaption>
    </figure>
  </div>
</section>
<section class="band" id="install">
  <p class="eyebrow">Install</p>
  <h2>Up and running in one line.</h2>
  <p>For Windows, macOS and Linux, on Intel and AMD (amd64) or ARM (arm64)
     machines.</p>
  <!-- Both commands are in the markup. With scripting on, the tabs show the one
       for the visitor's own system; with it off, both are simply listed.

       Under each installer are its system's archives, as plain links to the
       names scripts/publish-downloads.sh gives the latest release's files, for
       somebody who would rather not pipe a script into a shell. The installer
       stays first: it checks the download, puts it on the PATH, and leaves no
       download mark for Gatekeeper or SmartScreen to stop. -->
  <div class="os-tabs" role="tablist" aria-label="Your operating system" hidden>
    <button type="button" role="tab" id="os-tab-unix" aria-controls="os-unix" data-os="unix">macOS &amp; Linux</button>
    <button type="button" role="tab" id="os-tab-windows" aria-controls="os-windows" data-os="windows">Windows</button>
  </div>
  <div class="os" id="os-unix" data-os="unix">
    <p class="os-label">macOS and Linux:</p>
    <pre><code>curl -fsSL {{ .URL }}/install.sh | sh</code></pre>
    <p>Or download it:</p>
    <ul class="downloads" aria-label="Downloads for macOS and Linux">
      <li><a class="button ghost dl" href="{{ .Downloads }}/latest/flockdeck_darwin_arm64.tar.gz"><span aria-hidden="true">↓</span> macOS (Apple silicon)</a></li>
      <li><a class="button ghost dl" href="{{ .Downloads }}/latest/flockdeck_darwin_amd64.tar.gz"><span aria-hidden="true">↓</span> macOS (Intel)</a></li>
      <li><a class="button ghost dl" href="{{ .Downloads }}/latest/flockdeck_linux_amd64.tar.gz"><span aria-hidden="true">↓</span> Linux (x64)</a></li>
      <li><a class="button ghost dl" href="{{ .Downloads }}/latest/flockdeck_linux_arm64.tar.gz"><span aria-hidden="true">↓</span> Linux (Arm)</a></li>
    </ul>
  </div>
  <div class="os" id="os-windows" data-os="windows">
    <p class="os-label">Windows (PowerShell):</p>
    <pre><code>irm {{ .URL }}/install.ps1 | iex</code></pre>
    <p>Or download it:</p>
    <ul class="downloads" aria-label="Downloads for Windows">
      <li><a class="button ghost dl" href="{{ .Downloads }}/latest/flockdeck_windows_amd64.zip"><span aria-hidden="true">↓</span> Windows (x64)</a></li>
      <li><a class="button ghost dl" href="{{ .Downloads }}/latest/flockdeck_windows_arm64.zip"><span aria-hidden="true">↓</span> Windows (Arm)</a></li>
    </ul>
  </div>
  <p class="aside">Each archive holds the program itself: unpack it and run it.
     Its checksum is in that release's <code>checksums.txt</code>, and every
     release is also on <a href="{{ .Repo }}/releases">GitHub</a>. The
     binaries are not signed, so macOS and Windows may refuse to open a copy
     downloaded in a browser. On macOS, run
     <code>xattr -d com.apple.quarantine</code> on it, or allow it under
     System Settings → Privacy &amp; Security; on Windows, choose More info →
     Run anyway. The installers above leave no download mark, so they meet
     neither.</p>
  <p>The installer checks its download against the checksum written into the
     installer itself, and installs it to <code>~/.local/bin</code>. On
     Windows it goes to <code>%LOCALAPPDATA%\Programs\flockdeck</code> and
     adds a Start menu shortcut. With that in and checked, it moves you on to
     the latest release, if this page is older than that, by asking the copy
     it just installed to update itself — checked by its release signature,
     not by anything the installer downloaded. No admin rights needed, now or
     when Flockdeck updates itself. To pick a release or a directory, set
     <code>FLOCKDECK_VERSION</code> or <code>FLOCKDECK_INSTALL_DIR</code>
     first; each script lists its settings at the top. A release picked this
     way is checked against the <code>checksums.txt</code> downloaded with it,
     and is left exactly as installed rather than moved to the latest. To
     also stop Flockdeck updating itself once it runs, set
     <code>FLOCKDECK_UPDATE=off</code> where Flockdeck runs (with
     <code>setx</code> on Windows, or in your shell profile). View the scripts: <a href="install.sh">install.sh</a> ·
     <a href="install.ps1">install.ps1</a></p>
  <p>Using Go?</p>
  <pre><code>go install {{ .Module }}@latest</code></pre>
  <p>Or build from source:</p>
  <pre><code>make build      <span class="c"># a binary for this machine</span>
make package    <span class="c"># archives for all six platforms</span></code></pre>
  <p>No <code>make</code>, as on many Windows machines? <code>go build .</code>
     builds the same program. A build made any of these ways never updates
     itself: update it the same way you installed it.</p>
  <p>Flockdeck checks for updates, verifies every download and asks before it
     restarts, so an update never interrupts your work.</p>
  <p>Command-line agents use the login they already have, so Claude Code works
     with no extra setup. To use a model API directly, add your key with
     <code>flockdeck keys</code>.</p>
  <p class="aside">Press <kbd>F1</kbd> in the app for the full guide and keyboard
     shortcuts, or read it at <a href="https://docs.flockdeck.ai/">docs.flockdeck.ai</a>.</p>
</section>

<section class="band" id="faq">
  <p class="eyebrow">FAQ</p>
  <h2>Questions, answered.</h2>
  <div class="faq">
    <details open>
      <summary>Is Flockdeck free?</summary>
      <p>The desktop app is, for good: it's free and open source under the MIT
         licence, on your own computer or self-hosted on a server you run.
         Reaching it from your phone through Flockdeck's shared relay is free
         for a 30-day trial, then a small subscription — there's no permanent
         free tier for the relay, since somebody has to pay for running it.</p>
      <p>If you'd like to say thank you, you can
         <a href="#sponsor">sponsor Flockdeck</a>. It buys nothing: the app is
         the same for everyone.</p>
    </details>
    <details>
      <summary>Is there a paid version?</summary>
      <p>The shared relay is a subscription after its free trial. Companies
         that can't have Flockdeck's relay in the loop at all can license the
         whole stack — relay and remote access included — to run entirely on
         their own infrastructure, with SSO: see
         <a href="#enterprise">Enterprise</a>, in progress, with SSO and an
         audit log already built and under test — see
         <a href="https://docs.flockdeck.ai/self-hosting/overview.html">self-hosting the relay</a>.
         The app stays free and open source.</p>
    </details>
    <details>
      <summary>Which agents does it work with?</summary>
      <p>Claude Code, Codex, Gemini CLI, Aider, opencode and Cursor Agent out of
         the box. It can also talk to Anthropic, OpenAI and Google models
         directly, or to any OpenAI-compatible endpoint such as Ollama. Any
         other command-line agent can be added in <code>agents.json</code>.</p>
    </details>
    <details>
      <summary>Does my code leave my machine?</summary>
      <p>Flockdeck runs on your computer and doesn't collect your code. Your
         agents talk to their own providers, just as they would in a terminal.
         Flockdeck itself only contacts dl.flockdeck.ai to check for updates,
         with GitHub as a mirror; the relay, if you turn on remote access;
         your git remotes, when you push, pull or fetch; and, when you store
         an API key, that provider, once, to check the key. The exception is the built-in API
         agents: they send your conversations to the model provider you
         choose, with your own key. Routing and the cost estimates add no
         connection of their own. The <a href="privacy.html">privacy
         policy</a> has the details, and <a href="trust.html">trust &amp;
         privacy</a> has the short version, including how that compares to
         other coding assistants.</p>
    </details>
    <details>
      <summary>Do I need API keys?</summary>
      <p>Not for command-line agents. Claude Code and the others use the login
         they already have. You only need a key to talk to a model API directly,
         and <code>flockdeck keys</code> stores it for you.</p>
    </details>
    <details>
      <summary>Are the cost figures my bill?</summary>
      <p>No, they're estimates. An API agent's tokens are priced from a dated
         table of the providers' published prices, built into the app. Claude
         Code's figures come from its status line, by default only where you
         have one of your own: on an API key it shows its own estimate, and on
         a subscription the pane leads with your five-hour and weekly limits
         instead. Flockdeck works all of it out on your machine and sends it
         nowhere, except to your own paired devices with the rest of your
         panes if you turn on remote access.</p>
    </details>
    <details>
      <summary>Can I use it from my phone?</summary>
      <p>Yes. Turn on remote access and pair your phone with a QR code. A
         Claude Code pane, or Flockdeck's own chat client, opens as a
         conversation rather than a raw terminal — Markdown replies, diffs,
         and a question or permission prompt answered with a tap, even
         straight from the list of what's waiting. Long replies and code fold
         so you're not scrolling past them, and you can send a photo or
         several straight from the chat. You can search a
         conversation, and start a new agent without going to the desk.
         Traffic is encrypted with TLS over the internet and routed through the
         Flockdeck relay, which decrypts it to route it, so remote access is not
         end-to-end encrypted. You can also turn on notifications, so your
         phone tells you when an agent needs you and you're away from your
         desk. Those are the exception: each one is sealed on your desktop for
         that device alone, so the relay can't read it either.</p>
    </details>
    <details>
      <summary>How do updates work?</summary>
      <p>Flockdeck checks dl.flockdeck.ai for new releases, with GitHub as a
         mirror. It verifies every download against its published checksum,
         accepts a release from dl.flockdeck.ai only when the release key has
         signed it, and asks before it restarts. If you
         don't restart, the new version goes in the next time you quit. The
         installers above do this once too, right after installing, so a
         fresh install lands on the latest release even if this page was
         generated for an older one. To turn updates off, set
         <code>FLOCKDECK_UPDATE=off</code>.</p>
    </details>
    <details>
      <summary>How do I uninstall it?</summary>
      <p>If you turned on remote access, run <code>flockdeck remote disable</code>
         first so the relay forgets this machine. Then quit Flockdeck and delete
         the binary: <code>~/.local/bin/flockdeck</code>, or on Windows the
         <code>%LOCALAPPDATA%\Programs\flockdeck</code> folder and the Flockdeck
         Start menu shortcut, and remove that folder from your user PATH. Your
         settings, layouts and keys are kept apart from it, in
         <code>%AppData%\flockdeck</code>,
         <code>~/Library/Application Support/flockdeck</code> or
         <code>~/.config/flockdeck</code>; delete that too, and on Windows
         <code>%LOCALAPPDATA%\flockdeck</code>, which holds the window's browser
         profile. Worktrees Flockdeck
         made are ordinary git worktrees beside your repositories, and stay
         until you remove them.</p>
    </details>
    <details>
      <summary>Which platforms are supported?</summary>
      <p>Windows, macOS and Linux, on both Intel and AMD (amd64) and ARM
         (arm64) machines.</p>
    </details>
  </div>
</section>

<!-- Sponsoring: a way to give money that buys nothing, which the section says
     in so many words, since the likeliest trouble is a sponsor expecting
     priority. The names come from assets/sponsors.txt, and are only those
     who asked to be named: a name, and a link where they gave one, with no
     logo, so that a company's line is not an advertisement. -->
<section class="band" id="sponsor">
  <p class="eyebrow">Sponsor</p>
  <h2>Say thank you.</h2>
  <p>Flockdeck is free and open source. If it's useful to you or your
     company, you can sponsor it through GitHub Sponsors. Sponsoring buys no
     features, support or priority: the app is the same for everyone.</p>
  <p class="cta"><a class="button ghost" href="{{ .Sponsor }}">Sponsor on GitHub</a></p>
  <h3>Sponsors</h3>
  {{- if .Sponsors}}
  <ul class="sponsors">
    {{- range .Sponsors}}
    <li>{{if .Link}}<a href="{{.Link}}" rel="sponsored">{{.Name}}</a>{{else}}{{.Name}}{{end}}</li>
    {{- end}}
  </ul>
  {{- else}}
  <p>No one is listed yet.</p>
  {{- end}}
  <p class="aside">Sponsors are named here only if they ask to be, by name and
     a link.</p>
</section>

</main>

{{template "footer" .}}

<script>
// The deck runs a scripted session: three agents typing, one of them stopping
// to ask. It is a loop rather than a one-off because the moment that matters —
// a pane going amber — should not be something a visitor can arrive too late
// to see.
//
// Nothing here is load-bearing. The markup already shows a finished deck, so a
// visitor with scripting off, or with motion turned down, loses the typing and
// keeps the picture.
(function () {
  var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function term(id) { return document.querySelector('[data-term="' + id + '"]'); }

  // Each terminal's lines, read out of the markup with how long each waits.
  var SCRIPT = {};
  ["api", "ui", "docs"].forEach(function (id) {
    var t = term(id);
    if (!t) return;
    var at = (t.getAttribute("data-at") || "").split(" ");
    SCRIPT[id] = t.innerHTML.split("\n").map(function (l, i) { return [l, +at[i] || 0]; });
  });
  function pane(id) { return document.querySelector('[data-pane="' + id + '"]'); }
  function tabDot(id) { return document.querySelector('[data-tab="' + id + '"]'); }

  function setDot(el, cls, glyph) {
    if (!el) return;
    el.className = "dot " + cls;
    el.textContent = glyph;
  }

  function setPaneState(id, cls, glyph) {
    var p = pane(id);
    if (!p) return;
    p.classList.toggle("is-waiting", cls === "waiting");
    setDot(p.querySelector(".pane-head .dot"), cls, glyph);
    setDot(tabDot(id), cls, glyph);
    tally();
  }

  // The counts are the panes' own dots, counted, so the two cannot disagree.
  function tally() {
    ["waiting", "working"].forEach(function (cls) {
      var b = document.querySelector('[data-tally="' + cls + '"]');
      if (b) b.textContent = document.querySelectorAll("#deck .pane-head .dot." + cls).length;
    });
  }

  // The finished state, which is also what the page shows when it does not run.
  function settle() {
    for (var id in SCRIPT) {
      var t = term(id);
      if (t) t.innerHTML = SCRIPT[id].map(function (l) { return l[0]; }).join("\n");
    }
    setPaneState("api", "working", "●");
    setPaneState("ui", "waiting", "▲");
    setPaneState("docs", "idle", "●");
  }

  if (reduced) { settle(); return; }

  var timers = [];
  function after(ms, fn) { timers.push(setTimeout(fn, ms)); }
  function clear() { timers.forEach(clearTimeout); timers = []; }

  function play(id, whenDone) {
    var lines = SCRIPT[id], t = term(id), elapsed = 0;
    if (!t) return;
    t.innerHTML = "";
    lines.forEach(function (line, i) {
      elapsed += line[1];
      after(elapsed, function () {
        t.innerHTML = lines.slice(0, i + 1).map(function (l) { return l[0]; }).join("\n") +
          (i === lines.length - 1 ? "" : '\n<span class="caret"></span>');
        if (i === lines.length - 1 && whenDone) whenDone();
      });
    });
    return elapsed;
  }

  function run() {
    clear();
    ["api", "ui", "docs"].forEach(function (id) { setPaneState(id, "working", "●"); });

    play("api");
    play("docs", function () { setPaneState("docs", "idle", "●"); });
    play("ui", function () { setPaneState("ui", "waiting", "▲"); });

    // Long enough to sit on the finished picture before going round again.
    after(9000, run);
  }

  // Nothing animates while the deck is out of sight: not before it has been
  // seen, so a visitor who scrolls straight past has not missed it, and not
  // after it has been scrolled away or its tab put in the background, where a
  // loop that goes round every nine seconds would otherwise go on for as long
  // as the page is open.
  var deck = document.getElementById("deck");
  if (!deck || !("IntersectionObserver" in window)) { run(); return; }

  var inView = false, playing = false;
  function update() {
    var want = inView && !document.hidden;
    if (want === playing) return;
    playing = want;
    if (want) { run(); } else { clear(); settle(); }
  }
  new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { inView = e.isIntersecting; });
    update();
  }, { threshold: 0.25 }).observe(deck);
  document.addEventListener("visibilitychange", update);
  settle();
})();
</script>
<script>
// Install tabs and copy buttons. Both are conveniences over markup that
// already works: without this script every command is listed and can be
// selected and copied by hand.
(() => {
  const tabs = document.querySelector(".os-tabs");
  const panels = document.querySelectorAll(".os");
  const platform = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || "";
  if (tabs && panels.length) {
    const buttons = [...tabs.querySelectorAll("button")];
    // Only the selected tab is in the Tab order; the arrow keys move between
    // them, which is how a screen reader user expects a tab list to behave.
    const show = (os, focus) => {
      panels.forEach((p) => { p.hidden = p.dataset.os !== os; });
      buttons.forEach((b) => {
        const on = b.dataset.os === os;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
    };
    // The panels are only tab panels once the tabs are showing; without this
    // script they are two plain sections, each with its own label.
    panels.forEach((p) => {
      p.setAttribute("role", "tabpanel");
      p.setAttribute("aria-labelledby", "os-tab-" + p.dataset.os);
    });
    tabs.hidden = false;
    document.body.classList.add("has-os-tabs");
    tabs.addEventListener("click", (e) => { const b = e.target.closest("button"); if (b) show(b.dataset.os); });
    tabs.addEventListener("keydown", (e) => {
      const at = buttons.indexOf(document.activeElement);
      if (at < 0 || (e.key !== "ArrowLeft" && e.key !== "ArrowRight")) return;
      e.preventDefault();
      const next = buttons[(at + (e.key === "ArrowRight" ? 1 : buttons.length - 1)) % buttons.length];
      show(next.dataset.os, true);
    });
    show(/win/i.test(platform) ? "windows" : "unix");
  }

  if (!navigator.clipboard) return;
  document.querySelectorAll("#install pre, #remote pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code) return;
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy";
    btn.textContent = "Copy";
    // Comments are for reading, not for pasting into a shell.
    const text = [...code.childNodes].filter((n) => !(n.classList && n.classList.contains("c"))).map((n) => n.textContent).join("").replace(/[ \t]+$/gm, "");
    // Five buttons all called "Copy" tell a screen reader user nothing about
    // which command each one takes, so each is named after its first line.
    const label = "Copy " + text.trim().split("\n")[0];
    btn.setAttribute("aria-label", label);
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
      } catch {
        // Telling somebody to press the copy keys is only any use with
        // something selected for them to copy.
        getSelection().selectAllChildren(code);
        btn.textContent = /mac/i.test(platform) ? "Press ⌘C" : "Press Ctrl+C";
      }
      setTimeout(() => { btn.textContent = "Copy"; }, 1600);
    });
    pre.classList.add("has-copy");
    pre.append(btn);
  });
})();
</script>
</body>
