<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Flockdeck | Run all your coding agents at once</title>
<meta name="description" content="Flockdeck runs Claude Code, Codex, Gemini and other coding agents side by side, and shows you which one needs your input. For Windows, macOS and Linux.">
<link rel="icon" href="favicon.svg" type="image/svg+xml">
<meta property="og:title" content="Flockdeck | Run all your coding agents at once">
<meta property="og:description" content="Run all your coding agents side by side and see which one needs you.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;650;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="site.css">
</head>
<body>

<header class="top">
  <span class="wordmark">{{ mark }}Flockdeck</span>
  <nav>
    <a href="#what">Features</a>
    <a href="#remote">Remote</a>
    <a href="#install">Install</a>
    <a href="{{ .Repo }}">Source</a>
  </nav>
</header>

<main class="wrap">

<section class="hero">
  <p class="kicker"><span class="dot waiting">▲</span> Built for multi-agent coding</p>
  <h1>Run all your coding agents <em>at once</em>.</h1>
  <p class="lede">Flockdeck runs Claude Code, Codex, Gemini and more side by side
     in one desktop app, and shows you the moment an agent needs your input.</p>
  <p class="cta">
    <a class="button" href="#install">Install Flockdeck</a>
    <a class="button ghost" href="{{ .Repo }}">Source on GitHub</a>
  </p>
  <p class="cta-note">Windows, macOS and Linux · One download, no dependencies</p>
</section>

<!-- The hero is the application rather than a picture of it: the panes below
     run a scripted session, and the point of the whole thing — one agent going
     amber while the others carry on — happens in front of you. The markup is
     the finished state, so with scripting off, or motion turned down, the page
     still shows a deck with one pane waiting. -->
<section class="deck" id="deck" aria-label="A Flockdeck window with three agents running">
  <div class="deck-bar">
    <span class="deck-tab on"><span class="dot working" data-tab="api">●</span> api</span>
    <span class="deck-tab"><span class="dot working" data-tab="ui">●</span> ui</span>
    <span class="deck-tab"><span class="dot idle" data-tab="docs">●</span> docs</span>
    <span class="deck-tally">
      <span><span class="dot waiting">▲</span> <b data-tally="waiting">1</b> waiting</span>
      <span><span class="dot working">●</span> <b data-tally="working">2</b> working</span>
    </span>
  </div>
  <div class="deck-panes">
    <div class="pane" data-pane="api">
      <div class="pane-head"><span class="dot working">●</span> <span class="name">api</span> <span class="branch">feat/api</span></div>
      <pre class="term" data-term="api"></pre>
    </div>
    <div class="pane" data-pane="ui">
      <div class="pane-head"><span class="dot working">●</span> <span class="name">ui</span> <span class="branch">feat/ui</span></div>
      <pre class="term" data-term="ui"></pre>
    </div>
    <div class="pane wide" data-pane="docs">
      <div class="pane-head"><span class="dot idle">●</span> <span class="name">docs</span> <span class="branch">main</span></div>
      <pre class="term" data-term="docs"></pre>
    </div>
  </div>
</section>
<p class="deck-cap">Three agents on three branches. One needs you.</p>

<div class="legend" aria-label="What the status glyphs mean">
  <div><span class="dot working">●</span> <b>working</b> <span class="t">agent is running</span></div>
  <div><span class="dot waiting">▲</span> <b>waiting</b> <span class="t">needs your input</span></div>
  <div><span class="dot idle">●</span> <b>idle</b> <span class="t">finished its turn</span></div>
  <div><span class="dot exited">●</span> <b>exited</b> <span class="t">process has stopped</span></div>
</div>

<section class="band" id="why">
  <p class="eyebrow">The problem</p>
  <h2>One agent is easy. Five is chaos.</h2>
  <p>Agents finish at different times and stop for permission prompts. Before
     long you're flicking between terminals looking for the one that's stuck.
     Flockdeck shows you <strong>which agent needs you right now</strong>, and
     keeps each one on its own branch so they never trip over each other.</p>
</section>

<section class="band shot" id="app">
  <p class="eyebrow">In the app</p>
  <h2>Every agent in one window.</h2>
  <figure class="figure">
    <img src="deck.png" width="1584" height="985" loading="lazy" alt="A Flockdeck window with four agents in a two-by-two grid. Gemini CLI has written a four-step plan, Claude Code is running tests on the pricing branch, Codex is adding a search endpoint, and a second Claude Code pane is highlighted in amber, waiting for permission to run a migration.">
    <figcaption class="caption">Four agents on four branches. The amber pane is asking for approval.</figcaption>
  </figure>
</section>

<section class="band" id="what">
  <p class="eyebrow">Features</p>
  <h2>Everything you need to run a team of agents.</h2>
  <div class="grid">
    <div class="card">
      <span class="g">agents · models</span>
      <h3>Any agent, any model</h3>
      <p>Claude Code, Codex, Gemini, Aider, opencode and Cursor Agent. Or talk to
         a model API directly, including local Ollama and any OpenAI-compatible
         endpoint. Pick one per pane and Flockdeck remembers it for the project.</p>
    </div>
    <div class="card">
      <span class="g">▲ waiting</span>
      <h3>Know who needs you</h3>
      <p>Every pane shows whether its agent is working, waiting or done. Tabs and
         projects light up too, and you get a desktop notification when an agent
         is waiting while you're working somewhere else.</p>
    </div>
    <div class="card">
      <span class="g">git worktrees</span>
      <h3>Worktrees built in</h3>
      <p>Create, switch and clean up git worktrees without leaving the app, so
         your agents work in parallel without touching each other's files.</p>
    </div>
    <div class="card">
      <span class="g">fan out</span>
      <h3>Turn a plan into a team</h3>
      <p>Flockdeck reads the task list an agent wrote, lets you edit it, then
         starts one agent per task, each on its own branch.</p>
    </div>
    <div class="card">
      <span class="g">context</span>
      <h3>Agents that know the team</h3>
      <p>Each agent is told which pane it's in and what the others are working
         on, so it can coordinate instead of colliding.</p>
    </div>
    <div class="card">
      <span class="g">detach · reattach</span>
      <h3>Pick up where you left off</h3>
      <p>Your layout, open projects and conversations come back when you reopen
         Flockdeck. Detach, and your agents keep running after the window
         closes.</p>
    </div>
  </div>
</section>

<section class="band" id="fanout">
  <p class="eyebrow">Fan out</p>
  <h2>One plan in. A branch per task out.</h2>
  <p>Ask an agent for a plan and edit the list. Flockdeck starts an agent for
     every line, each in its own worktree, and your deck fills up.</p>
  <div class="fan">
    <div class="fan-plan">
      <ol>
        <li>Extract the config loader</li>
        <li>Add the retry policy</li>
        <li>Document the wire format</li>
      </ol>
    </div>
    <div class="fan-arrow" aria-hidden="true">→</div>
    <div class="fan-out">
      <ul>
        <li><span class="dot working">●</span> config-loader <span class="br">feat/config-loader</span></li>
        <li><span class="dot working">●</span> retry-policy <span class="br">feat/retry-policy</span></li>
        <li><span class="dot waiting">▲</span> wire-format <span class="br">docs/wire-format</span></li>
      </ul>
    </div>
  </div>
  <figure class="figure">
    <img src="fanout.png" width="1584" height="985" loading="lazy" alt="The Fan out dialog listing four tasks read from an agent's plan, with a model picker for the whole run and for each task, and an option to give each agent its own git worktree.">
    <figcaption class="caption">Fan out picks up the plan straight from the agent's output.</figcaption>
  </figure>
</section>

<!-- Remote access, as the design in flockdeck-relay settles it: dialling out,
     pairing, the same interface, and what the relay can see. The commands and
     the relay's address are left out, since those are the parts still free to
     change. -->
<section class="band" id="remote">
  <p class="eyebrow">Remote access</p>
  <h2>Check in on your agents from anywhere.</h2>
  <p>Leave Flockdeck running at your desk and pick it up from your laptop,
     tablet or phone. See <strong>which agent is waiting</strong> and unblock it
     from wherever you are.</p>
  <div class="relay" aria-label="A paired device reaches the desktop through the Flockdeck relay, which the desktop connects out to">
    <div class="relay-node">
      <span class="g">phone · tablet · laptop</span>
      <div class="relay-tally"><span class="dot waiting">▲</span> 1 waiting <span class="dot working">●</span> 2 working</div>
      <span class="t">any browser you've paired</span>
    </div>
    <div class="relay-link" aria-hidden="true"><span class="arrow">⟷</span><span class="t">TLS</span></div>
    <div class="relay-node hub">
      <span class="g">Flockdeck relay</span>
      <div class="relay-tally">secure connection</div>
      <span class="t">hosted for you</span>
    </div>
    <div class="relay-link" aria-hidden="true"><span class="arrow">⟵</span><span class="t">outbound · TLS</span></div>
    <div class="relay-node">
      <span class="g">your desktop</span>
      <div class="relay-tally"><span class="dot working">●</span> api <span class="dot waiting">▲</span> ui <span class="dot idle">●</span> docs</div>
      <span class="t">your agents keep running here</span>
    </div>
  </div>
  <div class="grid">
    <div class="card">
      <span class="g">outbound only</span>
      <h3>No ports. No VPN.</h3>
      <p>Your desktop connects out to the relay, so there's nothing to open on
         your router and nothing exposed to the internet.</p>
    </div>
    <div class="card">
      <span class="g">link · QR code</span>
      <h3>Pair in seconds</h3>
      <p>Scan a QR code or open a one-time link from your desktop. There are no
         passwords to set, and you can revoke any device at any time.</p>
    </div>
    <div class="card">
      <span class="g">full app</span>
      <h3>The complete Flockdeck</h3>
      <p>Every pane, every status, the agent picker and fan out. Everything you
         can do at your desk works in the browser.</p>
    </div>
    <div class="card">
      <span class="g">private</span>
      <h3>Only your desktops</h3>
      <p>Your devices reach your desktops and nobody else's. Connections are
         encrypted with TLS in both directions. The relay decrypts traffic to
         route it, so remote access is not end-to-end encrypted.</p>
    </div>
  </div>
  <p class="aside">Remote access is off until you turn it on. Turn it off and your
     desktop is removed from the relay.</p>
</section>
<section class="band shot">
  <p class="eyebrow">Built in</p>
  <h2>Pick any agent. See every branch.</h2>
  <div class="pair">
    <figure class="figure">
      <img src="agent-picker.png" width="1424" height="805" loading="lazy" alt="The Flockdeck window with the agent picker open over a pane. Claude Code is listed under Installed with its four models; Codex, Gemini, Aider, opencode, Cursor Agent and the API agents are listed below it, greyed, each with the command that installs it.">
      <figcaption class="caption">Pick an agent and model for each pane.</figcaption>
    </figure>
    <figure class="figure">
      <img src="worktrees.png" width="1584" height="985" loading="lazy" alt="The Worktrees panel listing main and three feature branches, each with its git status, the agents working in it, and buttons to open an agent, a shell or a review there.">
      <figcaption class="caption">Every checkout, its branch and the agents in it.</figcaption>
    </figure>
  </div>
</section>
<section class="band" id="install">
  <p class="eyebrow">Install</p>
  <h2>Up and running in one line.</h2>
  <ul class="platforms">
    <li>windows · amd64 · arm64</li>
    <li>macos · amd64 · arm64</li>
    <li>linux · amd64 · arm64</li>
  </ul>
  <p>macOS and Linux:</p>
  <pre><code>curl -fsSL {{ .URL }}/install.sh | sh</code></pre>
  <p>Windows (PowerShell):</p>
  <pre><code>irm {{ .URL }}/install.ps1 | iex</code></pre>
  <p>The installer downloads the latest release for your machine, verifies it,
     and installs it to <code>~/.local/bin</code>. On Windows it goes to
     <code>%LOCALAPPDATA%\Programs\flockdeck</code> and adds a Start menu
     shortcut. No admin rights needed, now or when Flockdeck updates itself.
     View the scripts: <a href="install.sh">install.sh</a> ·
     <a href="install.ps1">install.ps1</a></p>
  <p>Using Go?</p>
  <pre><code>go install {{ .Module }}@latest</code></pre>
  <p>Or build from source:</p>
  <pre><code>make build      <span class="c"># a binary for this machine</span>
make package    <span class="c"># archives for all six platforms</span></code></pre>
  <p>Downloads are also on the <a href="{{ .Repo }}/releases">releases page</a>.
     Flockdeck checks for updates, verifies every download and asks before it
     restarts, so an update never interrupts your work.</p>
  <p>Command-line agents use the login they already have, so Claude Code works
     with no extra setup. To use a model API directly, add your key with
     <code>flockdeck keys</code>.</p>
  <p class="aside">Press <kbd>F1</kbd> in the app for the full guide and keyboard
     shortcuts.</p>
</section>

</main>

<footer class="foot">
  <div class="wrap">
    <p>Flockdeck. Run all your coding agents at once.</p>
    <nav>
      <a href="{{ .Repo }}">Source</a>
      <a href="{{ .Repo }}/releases">Releases</a>
      <a href="{{ .Repo }}/blob/main/LICENSE">Licence</a>
    </nav>
  </div>
</footer>

<script>
// The deck runs a scripted session: three agents typing, one of them stopping
// to ask. It is a loop rather than a one-off because the moment that matters —
// a pane going amber — should not be something a visitor can arrive too late
// to see.
//
// Nothing here is load-bearing. The markup already shows a finished deck, so a
// visitor with scripting off, or with motion turned down, loses the typing and
// keeps the picture.
(function () {
  var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  var SCRIPT = {
    api: [
      ["<span class='u'>$</span> flockdeck — agent: claude-code", 0],
      ["<b>Reading</b> internal/api/router.go", 420],
      ["<b>Edit</b> internal/api/router.go <span class='dim'>+38 −12</span>", 760],
      ["<b>Running</b> go test ./internal/api/", 700],
      ["<span class='ok'>ok</span>  internal/api  <span class='dim'>1.284s</span>", 900]
    ],
    ui: [
      ["<span class='u'>$</span> flockdeck — agent: codex", 0],
      ["<b>Reading</b> internal/webui/assets/app.js", 500],
      ["<b>Edit</b> internal/webui/assets/app.css <span class='dim'>+21 −4</span>", 820],
      ["<span class='warn'>▲ Permission needed</span>", 700],
      ["<span class='warn'>Allow write to internal/webui/assets/?</span>", 260],
      ["<span class='dim'>waiting for you…</span>", 200]
    ],
    docs: [
      ["<span class='u'>$</span> flockdeck — agent: gemini", 0],
      ["<b>Reading</b> README.md", 560],
      ["<b>Edit</b> README.md <span class='dim'>+64 −9</span>", 900],
      ["<span class='dim'>finished its turn</span>", 700]
    ]
  };

  function term(id) { return document.querySelector('[data-term="' + id + '"]'); }
  function pane(id) { return document.querySelector('[data-pane="' + id + '"]'); }
  function tabDot(id) { return document.querySelector('[data-tab="' + id + '"]'); }

  function setDot(el, cls, glyph) {
    if (!el) return;
    el.className = "dot " + cls;
    el.textContent = glyph;
  }

  function setPaneState(id, cls, glyph) {
    var p = pane(id);
    if (!p) return;
    p.classList.toggle("is-waiting", cls === "waiting");
    setDot(p.querySelector(".pane-head .dot"), cls, glyph);
    setDot(tabDot(id), cls, glyph);
  }

  // The finished state, which is also what the page shows when it does not run.
  function settle() {
    for (var id in SCRIPT) {
      var t = term(id);
      if (t) t.innerHTML = SCRIPT[id].map(function (l) { return l[0]; }).join("\n");
    }
    setPaneState("api", "working", "●");
    setPaneState("ui", "waiting", "▲");
    setPaneState("docs", "idle", "●");
  }

  if (reduced) { settle(); return; }

  var timers = [];
  function after(ms, fn) { timers.push(setTimeout(fn, ms)); }
  function clear() { timers.forEach(clearTimeout); timers = []; }

  function play(id, whenDone) {
    var lines = SCRIPT[id], t = term(id), at = 0, elapsed = 0;
    if (!t) return;
    t.innerHTML = "";
    lines.forEach(function (line, i) {
      elapsed += line[1];
      after(elapsed, function () {
        t.innerHTML = lines.slice(0, i + 1).map(function (l) { return l[0]; }).join("\n") +
          (i === lines.length - 1 ? "" : '\n<span class="caret"></span>');
        at = i;
        if (i === lines.length - 1 && whenDone) whenDone();
      });
    });
    return elapsed;
  }

  function tally(waiting, working) {
    var w = document.querySelector('[data-tally="waiting"]');
    var k = document.querySelector('[data-tally="working"]');
    if (w) w.textContent = waiting;
    if (k) k.textContent = working;
  }

  function run() {
    clear();
    ["api", "ui", "docs"].forEach(function (id) { setPaneState(id, "working", "●"); });
    tally(0, 3);

    play("api");
    play("docs", function () { setPaneState("docs", "idle", "●"); tally(0, 2); });
    play("ui", function () { setPaneState("ui", "waiting", "▲"); tally(1, 2); });

    // Long enough to sit on the finished picture before going round again.
    after(9000, run);
  }

  // Nothing animates until the deck has been seen, so a visitor who scrolls
  // straight past has not missed it, and a background tab is not spending
  // anything.
  var deck = document.getElementById("deck");
  if (!deck || !("IntersectionObserver" in window)) { run(); return; }

  var started = false;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting && !started) { started = true; run(); }
    });
  }, { threshold: 0.25 });
  io.observe(deck);
  settle();
})();
</script>
</body>
</html>
